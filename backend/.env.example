# =============================================================================
# Student Quiz Dashboard — Backend Environment
# Copy this file to `.env` and replace every __FILL_ME__ value.
# Never commit `.env` to version control.
# =============================================================================

# --- Runtime ---
# Use `production` on Render, `development` locally.
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins (no trailing slash).
# Local dev:  http://localhost:5173
# Production: https://your-app.vercel.app,https://your-app-git-main-you.vercel.app
CLIENT_URL=http://localhost:5173

# --- MongoDB ---
# Examples:
#   Local:    mongodb://localhost:27017/quizdash
#   Atlas:    mongodb+srv://<user>:<pass>@<cluster>/quizdash?retryWrites=true&w=majority
MONGO_URI=__FILL_ME__

# --- JWT ---
# Use a long random string (>=32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=__FILL_ME__
JWT_REFRESH_SECRET=__FILL_ME__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Cookies (refresh token) ---
# Local dev (same site, http):     COOKIE_SECURE=false  COOKIE_SAME_SITE=strict
# Cross-site prod (Vercel↔Render): COOKIE_SECURE=true   COOKIE_SAME_SITE=none
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
COOKIE_DOMAIN=

# --- Redis (optional) ---
# Leave blank to use in-memory node-cache fallback (single-process dev only).
# Example: redis://default:<password>@<host>:<port>
REDIS_URL=

# --- Cache TTLs (seconds) ---
CACHE_TTL_QUIZ_LIST=300
CACHE_TTL_QUIZ_DETAIL=600
CACHE_TTL_ANALYTICS=300
CACHE_TTL_LEADERBOARD=600

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_GENERAL=100

# --- Logging ---
LOG_LEVEL=info

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=10
