# =============================================================================
# Student Quiz Dashboard — Frontend Environment
# Copy to `.env` for local dev, set these in Vercel for production.
# All public vars must be VITE_-prefixed.
# =============================================================================

# Use a relative path. The Vite dev server proxies /api → http://localhost:5000
# locally, and Vercel rewrites /api → the Render backend in production. This
# keeps the auth cookie first-party in both environments (which matters for
# incognito mode, where browsers block third-party cookies).
VITE_API_BASE_URL=/api

VITE_APP_NAME=VedQ
